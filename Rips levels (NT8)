                }
            }
            else if (State == State.Terminated)
            {
                if (ChartControl != null)
                {
                    ChartControl.Dispatcher.InvokeAsync(() => { DisposeWPFControls(); });
                }
            }
        }

        private void ParseActiveLevels()
        {
            activeLevels.Clear();
            if (Instrument == null) return;
            
            string name = Instrument.FullName.ToUpper();
            
            bool isES = name.Contains("ES") || name.Contains("SPX") || name.Contains("SPY");
            bool isNQ = name.Contains("NQ") || name.Contains("NDX") || name.Contains("QQQ");

            bool drawES = DetectMode == RipsMode.ES || DetectMode == RipsMode.Both || (DetectMode == RipsMode.Auto && isES);
            bool drawNQ = DetectMode == RipsMode.NQ || DetectMode == RipsMode.Both || (DetectMode == RipsMode.Auto && isNQ);

            if (drawES) LoadFromString(EsLevelsStr);
            if (drawNQ) LoadFromString(NqLevelsStr);
        }

        private void LoadFromString(string inputStr)
        {
            if (string.IsNullOrWhiteSpace(inputStr)) return;
            string[] parts = inputStr.Split(new char[] { ',', ' ', '\n', '\r', '\t' }, StringSplitOptions.RemoveEmptyEntries);
            
            foreach (string p in parts)
            {
                if (double.TryParse(p, out double val))
                {
                    if (!activeLevels.Contains(val)) activeLevels.Add(val);
                }
            }
        }

        #region WPF UI Button Setup
        private void CreateWPFControls()
        {
            if (buttonContainer != null) return;

            toggleButton = new Button()
            {
                Content = isToolActive ? "RIPS: ON" : "RIPS: OFF",
                Background = isToolActive ? ButtonOnColor : ButtonOffColor,
                Foreground = Brushes.Black,
                FontWeight = FontWeights.Bold,
                FontSize = 12,
                BorderBrush = Brushes.Transparent, 
                BorderThickness = new Thickness(0),
                Padding = new Thickness(10, 4, 10, 4),
                Cursor = Cursors.Arrow,
                Focusable = false
            };

            toggleButton.Click += ToggleButton_Click;

            buttonContainer = new Border()
            {
                Background = new SolidColorBrush(Color.FromArgb(220, 30, 30, 30)),
                BorderBrush = new SolidColorBrush(Color.FromArgb(255, 90, 90, 90)),
                BorderThickness = new Thickness(1),
                CornerRadius = new CornerRadius(2),
                Padding = new Thickness(2), 
                Margin = new Thickness(ButtonXOffset, ButtonYOffset, 0, 0),
                HorizontalAlignment = HorizontalAlignment.Left,
                VerticalAlignment = VerticalAlignment.Top,
                Child = toggleButton
            };

            UserControlCollection.Add(buttonContainer);
        }

        private void DisposeWPFControls()
        {
            if (buttonContainer != null)
            {
                if (toggleButton != null) toggleButton.Click -= ToggleButton_Click;
                UserControlCollection.Remove(buttonContainer);
                buttonContainer = null;
                toggleButton = null;
            }
        }

        private void ToggleButton_Click(object sender, RoutedEventArgs e)
        {
            isToolActive = !isToolActive;
            
            TriggerCustomEvent(o =>
            {
                if (isToolActive)
                {
                    toggleButton.Content = "RIPS: ON";
                    toggleButton.Background = ButtonOnColor;
                }
                else
                {
                    toggleButton.Content = "RIPS: OFF";
                    toggleButton.Background = ButtonOffColor;
                }
                ChartControl?.InvalidateVisual();
            }, null);
        }
