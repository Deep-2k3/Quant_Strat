                NqLevelsStr = "30830.00, 30663.25, 30560.00, 30475.50, 30376.25, 30314.75, 30265.25, 30215.50, 30178.00, 30122.00, 30030.25, 29973.25, 29925.50, 29881.25, 29826.50, 29789.25, 29732.25, 29685.50, 29640.50, 29586.25, 29525.25, 29473.25, 29426.00, 29390.00, 29354.25, 29301.75, 29262.75, 29210.75, 29116.75, 29059.75, 29011.50, 28964.75";
                DetectMode = RipsMode.Auto;

