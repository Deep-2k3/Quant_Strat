        protected override void OnBarUpdate() { }

        protected override void OnRender(ChartControl chartControl, ChartScale chartScale)
        {
            base.OnRender(chartControl, chartScale);

            if (!isToolActive || Bars == null || ChartPanel == null || activeLevels.Count == 0) return;

            DateTime lastTime = Bars.GetTime(Bars.Count - 1);
            float screenWidth = (float)RenderTarget.Size.Width;
            float endBarX = chartControl.GetXByTime(lastTime);
            float labelX = endBarX + (LabelOffsetBars * chartControl.Properties.BarDistance);

            var scbLine = LineColor as SolidColorBrush;
            var scbLblText = LabelTextColor as SolidColorBrush;
            var scbLblBg = LabelBgColor as SolidColorBrush;

            if (scbLine == null || scbLblText == null || scbLblBg == null) return;

            using (var dxLine = new SharpDX.Direct2D1.SolidColorBrush(RenderTarget, new SharpDX.Color((int)scbLine.Color.R, (int)scbLine.Color.G, (int)scbLine.Color.B, 255)))
            using (var dxLblText = new SharpDX.Direct2D1.SolidColorBrush(RenderTarget, new SharpDX.Color((int)scbLblText.Color.R, (int)scbLblText.Color.G, (int)scbLblText.Color.B, 255)))
            using (var dxLblBg = new SharpDX.Direct2D1.SolidColorBrush(RenderTarget, new SharpDX.Color((int)scbLblBg.Color.R, (int)scbLblBg.Color.G, (int)scbLblBg.Color.B, 255)))
            using (var strokeStyle = new SharpDX.Direct2D1.StrokeStyle(RenderTarget.Factory, new SharpDX.Direct2D1.StrokeStyleProperties { DashStyle = GetDXDash(LineStyle) }))
            using (var lblFormat = new SharpDX.DirectWrite.TextFormat(NinjaTrader.Core.Globals.DirectWriteFactory, "Arial", SharpDX.DirectWrite.FontWeight.Bold, SharpDX.DirectWrite.FontStyle.Normal, LabelTextSize))
            {
                lblFormat.TextAlignment = SharpDX.DirectWrite.TextAlignment.Leading;

                // 1. RENDER INFINITE LINES & LABELS
                foreach (double lvl in activeLevels)
                {
                    float y = chartScale.GetYByValue(lvl);
                    
                    // Infinite Horizontal Line
                    RenderTarget.DrawLine(new SharpDX.Vector2(0, y), new SharpDX.Vector2(screenWidth, y), dxLine, LineWidth, strokeStyle);

                    // Offset Price Label
                    if (ShowLabels)
                    {
                        string txt = lvl.ToString("F2");
                        float txtWidth = txt.Length * (LabelTextSize * 0.6f) + 4;
                        float txtHeight = LabelTextSize + 4;
                        
                        var bgRect = new SharpDX.RectangleF(labelX, y - (txtHeight/2), txtWidth, txtHeight);
                        var txtRect = new SharpDX.RectangleF(labelX + 2, y - (LabelTextSize/2), txtWidth, LabelTextSize + 2);

                        RenderTarget.FillRectangle(bgRect, dxLblBg);
                        RenderTarget.DrawText(txt, lblFormat, txtRect, dxLblText);
                    }
                }

                // 2. RENDER ATR TABLE
                if (ShowTable && atr14 != null && CurrentBar > 14)
                {
                    RenderATRTable((float)RenderTarget.Size.Height, screenWidth);
                }
            }
        }

        private void RenderATRTable(float screenH, float screenW)
        {
            var scbHdrBg = TableHdrBg as SolidColorBrush;
            var scbHdrTxt = TableHdrText as SolidColorBrush;
            var scbBg = TableBg as SolidColorBrush;
            var scbTxt = TableText as SolidColorBrush;
            var scbBorder = TableBorder as SolidColorBrush;

            if (scbHdrBg == null || scbHdrTxt == null || scbBg == null || scbTxt == null || scbBorder == null) return;

            using (var dxHdrBg = new SharpDX.Direct2D1.SolidColorBrush(RenderTarget, new SharpDX.Color((int)scbHdrBg.Color.R, (int)scbHdrBg.Color.G, (int)scbHdrBg.Color.B, 255)))
            using (var dxHdrTxt = new SharpDX.Direct2D1.SolidColorBrush(RenderTarget, new SharpDX.Color((int)scbHdrTxt.Color.R, (int)scbHdrTxt.Color.G, (int)scbHdrTxt.Color.B, 255)))
            using (var dxBg = new SharpDX.Direct2D1.SolidColorBrush(RenderTarget, new SharpDX.Color((int)scbBg.Color.R, (int)scbBg.Color.G, (int)scbBg.Color.B, 255)))
            using (var dxTxt = new SharpDX.Direct2D1.SolidColorBrush(RenderTarget, new SharpDX.Color((int)scbTxt.Color.R, (int)scbTxt.Color.G, (int)scbTxt.Color.B, 255)))
            using (var dxBorder = new SharpDX.Direct2D1.SolidColorBrush(RenderTarget, new SharpDX.Color((int)scbBorder.Color.R, (int)scbBorder.Color.G, (int)scbBorder.Color.B, 255)))
            using (var tblFormat = new SharpDX.DirectWrite.TextFormat(NinjaTrader.Core.Globals.DirectWriteFactory, "Arial", SharpDX.DirectWrite.FontWeight.Bold, SharpDX.DirectWrite.FontStyle.Normal, TableTextSize))
            {
                tblFormat.TextAlignment = SharpDX.DirectWrite.TextAlignment.Center;
                
                float cellW = 100f;
                float cellH = TableTextSize + 10f;
                float tblW = cellW * 2;
                float tblH = cellH * 2;

                float startX = 20;
                float startY = 20;

                // Positioning
                if (TablePosition == RipsTablePos.TopRight || TablePosition == RipsTablePos.BottomRight) startX = screenW - tblW - 20;
                if (TablePosition == RipsTablePos.BottomLeft || TablePosition == RipsTablePos.BottomRight) startY = screenH - tblH - 20;

                // Header Cell (Merged)
                var hdrRect = new SharpDX.RectangleF(startX, startY, tblW, cellH);
                RenderTarget.FillRectangle(hdrRect, dxHdrBg);
                RenderTarget.DrawRectangle(hdrRect, dxBorder, 1);
                RenderTarget.DrawText("RIPS Levels", tblFormat, new SharpDX.RectangleF(startX, startY + 4, tblW, cellH), dxHdrTxt);

                // ATR Label Cell
                var atrLblRect = new SharpDX.RectangleF(startX, startY + cellH, cellW, cellH);
                RenderTarget.FillRectangle(atrLblRect, dxBg);
                RenderTarget.DrawRectangle(atrLblRect, dxBorder, 1);
                RenderTarget.DrawText("ATR", tblFormat, new SharpDX.RectangleF(startX, startY + cellH + 4, cellW, cellH), dxTxt);

                // ATR Value Cell
                var atrValRect = new SharpDX.RectangleF(startX + cellW, startY + cellH, cellW, cellH);
                RenderTarget.FillRectangle(atrValRect, dxBg);
                RenderTarget.DrawRectangle(atrValRect, dxBorder, 1);
                RenderTarget.DrawText(atr14[0].ToString("F2"), tblFormat, new SharpDX.RectangleF(startX + cellW, startY + cellH + 4, cellW, cellH), dxTxt);
            }
        }

        private SharpDX.Direct2D1.DashStyle GetDXDash(DashStyleHelper style)
        {
            switch (style)
            {
                case DashStyleHelper.Dash: return SharpDX.Direct2D1.DashStyle.Dash;
                case DashStyleHelper.Dot: return SharpDX.Direct2D1.DashStyle.Dot;
                default: return SharpDX.Direct2D1.DashStyle.Solid;
            }
        }

