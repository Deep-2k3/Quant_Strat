                TableHdrText = Brushes.Black;
                TableBg = Brushes.DarkSlateGray;
                TableText = Brushes.White;
                TableBorder = Brushes.Gray;
            }
            else if (State == State.DataLoaded)
            {
                atr14 = ATR(14);
                ParseActiveLevels();
