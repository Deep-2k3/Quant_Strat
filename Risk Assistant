namespace NinjaTrader.NinjaScript.Indicators
{
	public partial class Indicator : NinjaTrader.Gui.NinjaScript.IndicatorRenderBase
	{
		private RiskAssistant[] cacheRiskAssistant;
		public RiskAssistant RiskAssistant(double riskAmount, double defaultStopDistance)
		{
			return RiskAssistant(Input, riskAmount, defaultStopDistance);
		}

		public RiskAssistant RiskAssistant(ISeries<double> input, double riskAmount, double defaultStopDistance)
		{
			if (cacheRiskAssistant != null)
				for (int idx = 0; idx < cacheRiskAssistant.Length; idx++)
					if (cacheRiskAssistant[idx] != null && cacheRiskAssistant[idx].RiskAmount == riskAmount && cacheRiskAssistant[idx].DefaultStopDistance == defaultStopDistance && cacheRiskAssistant[idx].EqualsInput(input))
						return cacheRiskAssistant[idx];
			return CacheIndicator<RiskAssistant>(new RiskAssistant(){ RiskAmount = riskAmount, DefaultStopDistance = defaultStopDistance }, input, ref cacheRiskAssistant);
		}
	}
}

