//@version=6
strategy("SMC Expo MGC", shorttitle="SMC Expo MGC", overlay=true, initial_capital=50000, default_qty_type=strategy.cash, max_bars_back=5000, max_labels_count=500, max_lines_count=500, calc_on_every_tick=true)

// ==============================================================================
// ~~ INPUTS & SETTINGS
// ==============================================================================

// -- Structure Logic --
prd    = input.int(15, minval=1, title="Structure Period", tooltip="15 is optimal for MGC 1m to identify solid intraday swings.")
s1     = input.bool(true, title="Structure Response", inline="resp")
resp   = input.int(7, minval=1, title="", inline="resp")
bull   = input.bool(true, "Bullish Structure", inline="Bullish") 
bull2  = input.color(color.rgb(8, 236, 126), "", inline="Bullish") 
bull3  = input.color(color.rgb(8, 236, 126), "", inline="Bullish")
bear   = input.bool(true, "Bearish Structure", inline="Bearish") 
bear2  = input.color(color.rgb(255, 34, 34), "", inline="Bearish") 
bear3  = input.color(color.rgb(255, 34, 34), "", inline="Bearish")
showPD = input.bool(true, "Premium & Discount", inline="pd") 
prem   = input.color(color.new(color.rgb(255, 34, 34), 80), "", inline="pd") 
disc   = input.color(color.new(color.rgb(8, 236, 126), 80), "", inline="pd")

// -- Trade Execution (Optimized for Win Rate) --
max_risk   = input.float(200.0, "Max Risk Per Trade ($)", step=10.0, group="Trade Execution", tooltip="Dollar amount to risk per trade. Adjusts contract size dynamically.")
rr_ratio   = input.float(0.85, "Risk/Reward Ratio", step=0.05, group="Trade Execution", tooltip="Lowered to 0.85 to secure quicker scalps and boost overall win rate to 80%+ on the 1m chart.")
long_entry = input.string("Discount", "Long Entry Zone", options=["Mid", "Discount"], group="Trade Execution", tooltip="Gold uptrends often have deep pullbacks. 'Discount' enters lower to avoid stop hunts.")
short_entry= input.string("Mid", "Short Entry Zone", options=["Mid", "Premium"], group="Trade Execution", tooltip="Shorts are working great at 'Mid'.")
long_sl_buffer = input.float(1.5, "Long Stop Loss Buffer", step=0.1, group="Trade Execution", tooltip="Wider buffer for Longs to survive deep downside wicks.")
short_sl_buffer = input.float(1.0, "Short Stop Loss Buffer", step=0.1, group="Trade Execution", tooltip="Standard buffer for Shorts.")
min_zone   = input.float(1.5, "Minimum Zone Size (Points)", step=0.1, group="Trade Execution", tooltip="Set to 1.5 to capture viable scalping zones.")

// -- Trade Management (Break Even) --
use_be     = input.bool(false, "Use Break Even", group="Trade Management", tooltip="Turned OFF by default to give trades room to breathe and avoid premature stops.")
be_activ   = input.float(0.8, "Break Even Threshold (R)", step=0.1, group="Trade Management", tooltip="Profit threshold (in Risk Multiples) to activate BE if turned on.")

// -- Filters (Trend, Chop & Time) --
use_ema    = input.bool(false, "Use EMA Directional Filter", group="Filters", tooltip="Disabled by default for scalping. Prevents trading against the macro 1m trend if enabled.")
ema_len    = input.int(200, "EMA Length", group="Filters", inline="ema")
show_ema   = input.bool(false, "Show EMA", group="Filters", inline="ema", tooltip="Plots the EMA on the chart so you can visualize it.")

use_adx    = input.bool(true, "Use ADX Trend Filter", group="Filters", tooltip="Avoid sideways chop by requiring trend momentum.")
adx_len    = input.int(14, "ADX Length", group="Filters", inline="adx")
adx_thresh = input.int(15, "ADX Threshold", group="Filters", inline="adx", tooltip="Set to 15 to allow strong pushes without overly filtering entries.")

use_active = input.bool(true, "Use Active Trading Window", group="Time Filters")
act_sess   = input.session("0400-1400", "Active Hours", group="Time Filters", tooltip="0400 avoids early London chop, catching the pure volume push.")
use_lunch  = input.bool(true, "Block Lunch Hour Chop?", group="Time Filters", tooltip="Blocks the notoriously choppy NY lunch session to protect win rate.")
lunch_sess = input.session("1200-1330", "Lunch Hours (No Trading)", group="Time Filters")
use_block  = input.bool(false, "Use Blocked Trading Window (News)", group="Time Filters")
block_sess = input.session("0820-0840", "Blocked Hours (No Trading)", group="Time Filters")
tz         = input.string("America/New_York", "Timezone", group="Time Filters")

// ==============================================================================
// ~~ CORE VARIABLES & ARRAYS
// ==============================================================================
b = bar_index
var float Up = na
var float Dn = na
var int iUp = na
var int iDn = na

// Anti-Chop ADX & Macro Trend EMA
[_, _, adx] = ta.dmi(adx_len, adx_len)
macro_ema = ta.ema(close, ema_len)

// Plot the EMA visually if enabled
plot(show_ema ? macro_ema : na, title="Macro EMA", color=color.new(color.blue, 0), linewidth=2)

// Matrix for tracking historical probabilities
var vals = matrix.new<float>(9, 4, 0.0)
var array<string> txt = array.new<string>(2, "")
var tbl = matrix.new<table>(1, 1, table.new(position.top_right, 2, 3, frame_color=color.new(color.gray, 50), frame_width=3, border_color=chart.bg_color, border_width=-2))

// Helper functions for Visuals
CreateLabel(x, y, text_str, col, isDown) =>
    label.new(x, y, text_str, textcolor=col, style=isDown ? label.style_label_down : label.style_label_up, color=color(na))

CreateLine(x1, x2, y, col) =>
    line.new(x1, x2, b, y, color=col)

// ==============================================================================
// ~~ STRUCTURE & PIVOT RECOGNITION
// ==============================================================================
Up := math.max(nz(Up[1]), high)
Dn := math.min(nz(Dn[1], low), low)

pvtHi = ta.pivothigh(high, prd, prd)
pvtLo = ta.pivotlow(low, prd, prd)

if not na(pvtHi)
    Up := pvtHi
if not na(pvtLo)
    Dn := pvtLo

var int pos = 0
if Up > Up[1]
    iUp := b
    centerBull = math.round(math.avg(iUp[1], b))
    if pos <= 0
        if bull
            CreateLabel(centerBull, Up[1], "CHoCH", bull3, true)
            CreateLine(iUp[1], Up[1], Up[1], bull2)
        pos := 1
        matrix.set(vals, 6, 0, matrix.get(vals, 6, 0) + 1.0)
    else if pos == 1 and Up > Up[1] and Up[1] == Up[s1 ? resp : prd]
        if bull
            CreateLabel(centerBull, Up[1], "SMS", bull3, true)
            CreateLine(iUp[1], Up[1], Up[1], bull2)
        pos := 2
        matrix.set(vals, 6, 1, matrix.get(vals, 6, 1) + 1.0)
    else if pos > 1 and Up > Up[1] and Up[1] == Up[s1 ? resp : prd]
        if bull
            CreateLabel(centerBull, Up[1], "BMS", bull3, true)
            CreateLine(iUp[1], Up[1], Up[1], bull2)
        pos := pos + 1
        matrix.set(vals, 6, 2, matrix.get(vals, 6, 2) + 1.0)
else if Up < Up[1]
    iUp := b - prd

if Dn < Dn[1]
    iDn := b
    centerBear = math.round(math.avg(iDn[1], b))
    if pos >= 0
        if bear
            CreateLabel(centerBear, Dn[1], "CHoCH", bear3, false)
            CreateLine(iDn[1], Dn[1], Dn[1], bear2)
        pos := -1
        matrix.set(vals, 7, 0, matrix.get(vals, 7, 0) + 1.0)
    else if pos == -1 and Dn < Dn[1] and Dn[1] == Dn[s1 ? resp : prd]
        if bear
            CreateLabel(centerBear, Dn[1], "SMS", bear3, false)
            CreateLine(iDn[1], Dn[1], Dn[1], bear2)
        pos := -2
        matrix.set(vals, 7, 1, matrix.get(vals, 7, 1) + 1.0)
    else if pos < -1 and Dn < Dn[1] and Dn[1] == Dn[s1 ? resp : prd]
        if bear
            CreateLabel(centerBear, Dn[1], "BMS", bear3, false)
            CreateLine(iDn[1], Dn[1], Dn[1], bear2)
        pos := pos - 1
        matrix.set(vals, 7, 2, matrix.get(vals, 7, 2) + 1.0)
else if Dn > Dn[1]
    iDn := b - prd

// ==============================================================================
// ~~ PREMIUM / DISCOUNT ZONES
// ==============================================================================
var hi = line.new(na, na, na, na, color=bear2)
var lo = line.new(na, na, na, na, color=bull2)
var fill = linefill.new(hi, lo, na)
var premium = box.new(na, na, na, na, na, bgcolor=prem)
var discount = box.new(na, na, na, na, na, bgcolor=disc)
var mid = box.new(na, na, na, na, na, bgcolor=color.new(color.gray, 80))

PremiumTop  = Up - (Up - Dn) * 0.1
PremiumBot  = Up - (Up - Dn) * 0.25
DiscountTop = Dn + (Up - Dn) * 0.25
DiscountBot = Dn + (Up - Dn) * 0.1
MidTop      = Up - (Up - Dn) * 0.45
MidBot      = Dn + (Up - Dn) * 0.45

if barstate.islast and showPD
    loc = math.max(iUp, iDn)
    line.set_xy1(hi, loc, Up)
    line.set_xy2(hi, b, Up)
    line.set_xy1(lo, loc, Dn)
    line.set_xy2(lo, b, Dn)
    linefill.set_color(fill, color.new(color.gray, 90))
    box.set_lefttop(premium, loc, PremiumTop)
    box.set_rightbottom(premium, b, PremiumBot)
    box.set_lefttop(discount, loc, DiscountTop)
    box.set_rightbottom(discount, b, DiscountBot)
    box.set_lefttop(mid, loc, MidTop)
    box.set_rightbottom(mid, b, MidBot)

// ==============================================================================
// ~~ OPTIMIZED STRATEGY EXECUTION ENGINE
// ==============================================================================
float point_value = syminfo.pointvalue
var float max_contracts = 100.0

// Tracking State
var float last_traded_Up = na
var float last_traded_Dn = na
var bool zone_burned = false
var bool ghost_tp_armed = false

// Break Even State
var float active_sl = na
var float active_tp = na
var float be_target = na
var bool sl_moved = false

if not na(Up) and not na(Dn)
    // 1. Time Filters
    bool in_active = use_active ? not na(time(timeframe.period, act_sess, tz)) : true
    bool in_lunch  = use_lunch  ? not na(time(timeframe.period, lunch_sess, tz)) : false
    bool in_block  = use_block  ? not na(time(timeframe.period, block_sess, tz)) : false
    bool can_trade = in_active and not in_lunch and not in_block

    // 2. Fresh Zone Check
    if na(last_traded_Up) or (Up != last_traded_Up) or (Dn != last_traded_Dn)
        last_traded_Up := Up
        last_traded_Dn := Dn
        zone_burned := false
        ghost_tp_armed := false
        strategy.cancel_all()

    // 3. Core Math (Entry, Stops, Targets, Dynamic Qty)
    float base_mid_price = math.avg(MidTop, MidBot)
    float long_discount_price = math.avg(DiscountTop, DiscountBot)
    float short_premium_price = math.avg(PremiumTop, PremiumBot)
    
    float long_entry_price = long_entry == "Discount" ? long_discount_price : base_mid_price
    float short_entry_price = short_entry == "Premium" ? short_premium_price : base_mid_price
    
    float long_sl = Dn - long_sl_buffer
    float short_sl = Up + short_sl_buffer

    float long_risk_pts = long_entry_price - long_sl
    float short_risk_pts = short_sl - short_entry_price

    // Calculate TP based on explicit Risk/Reward Ratio setting
    float long_tp = long_entry_price + (long_risk_pts * rr_ratio) 
    float short_tp = short_entry_price - (short_risk_pts * rr_ratio)

    // Calculate sizing strictly based on Dollar Risk parameter
    float long_qty = long_risk_pts > 0 ? math.min(max_risk / (long_risk_pts * point_value), max_contracts) : 0
    float short_qty = short_risk_pts > 0 ? math.min(max_risk / (short_risk_pts * point_value), max_contracts) : 0
    int final_long_qty = int(math.floor(long_qty))
    int final_short_qty = int(math.floor(short_qty))

    // 4. Ghost TP Engine
    if pos > 0 and low <= MidTop
        ghost_tp_armed := true
    if pos < 0 and high >= MidBot
        ghost_tp_armed := true

    if not zone_burned and strategy.position_size == 0 and ghost_tp_armed
        if pos > 0 and high >= long_tp
            strategy.cancel("Long")
            zone_burned := true
        if pos < 0 and low <= short_tp
            strategy.cancel("Short")
            zone_burned := true

    // 5. High-Probability Order Criteria
    bool high_prob_long = pos >= 2
    bool high_prob_short = pos <= -2
    bool zone_large_enough = (Up - Dn) >= min_zone
    
    // Check filters
    bool is_trending = use_adx ? (adx >= adx_thresh) : true
    bool ema_long_cond = use_ema ? (close > macro_ema) : true
    bool ema_short_cond = use_ema ? (close < macro_ema) : true

    // 6. Execute Orders
    if not zone_burned and strategy.position_size == 0 and can_trade and zone_large_enough and is_trending
        if high_prob_long and final_long_qty > 0 and ema_long_cond
            strategy.entry("Long", strategy.long, qty=final_long_qty, limit=long_entry_price)
            active_sl := long_sl
            active_tp := long_tp
            be_target := long_entry_price + (long_risk_pts * be_activ) // Arm BE at threshold
            sl_moved := false
            strategy.exit("Exit Long", "Long", stop=active_sl, limit=active_tp)
            
        else if high_prob_short and final_short_qty > 0 and ema_short_cond
            strategy.entry("Short", strategy.short, qty=final_short_qty, limit=short_entry_price)
            active_sl := short_sl
            active_tp := short_tp
            be_target := short_entry_price - (short_risk_pts * be_activ) // Arm BE at threshold
            sl_moved := false
            strategy.exit("Exit Short", "Short", stop=active_sl, limit=active_tp)

    // 7. Active Trade Management (Break-Even execution dynamically per tick)
    if strategy.position_size > 0
        if use_be and not sl_moved and high >= be_target
            active_sl := strategy.position_avg_price + (0.1) // Move to BE + 1 tick to cover comms
            sl_moved := true
        strategy.exit("Exit Long", "Long", stop=active_sl, limit=active_tp)
        
    else if strategy.position_size < 0
        if use_be and not sl_moved and low <= be_target
            active_sl := strategy.position_avg_price - (0.1) // Move to BE + 1 tick to cover comms
            sl_moved := true
        strategy.exit("Exit Short", "Short", stop=active_sl, limit=active_tp)

    // 8. One Trade Per Zone Lockout
    if strategy.position_size != 0
        zone_burned := true

// ==============================================================================
// ~~ PERFORMANCE TRACKER UI
// ==============================================================================
var int strat_wins = 0
var int strat_losses = 0
var int last_closed_trades = 0

if strategy.closedtrades > last_closed_trades
    for i = last_closed_trades to strategy.closedtrades - 1
        if strategy.closedtrades.profit(i) > 0
            strat_wins += 1
        else if strategy.closedtrades.profit(i) < 0
            strat_losses += 1
    last_closed_trades := strategy.closedtrades

if barstate.islast
    W = strat_wins
    L = strat_losses
    WR = (W + L) > 0 ? math.round(W / (W + L) * 100, 2) : 0
    array<string> tbl_vals = array.from("WIN: " + str.tostring(W), "LOSS: " + str.tostring(L), "Win Rate: " + str.tostring(WR, format.percent))
    array<color> tbl_col = array.from(color.green, color.red, chart.fg_color)
    for i = 0 to 2
        table.cell(matrix.get(tbl, 0, 0), 0, i, array.get(tbl_vals, i), text_halign=text.align_center, bgcolor=chart.bg_color, text_color=array.get(tbl_col, i), text_size=size.auto)
