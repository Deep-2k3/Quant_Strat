//@version=6
indicator("Red Box Liquidity Sweep [Standalone]", overlay=true, max_boxes_count=100, max_labels_count=100)

// =========================================================================
// 1. INPUTS & PARAMETERS
// =========================================================================
grp_pivot = "Structural Pivots"
leftBars  = input.int(10, title="Pivot Left Bars", minval=1, group=grp_pivot)
rightBars = input.int(10, title="Pivot Right Bars", minval=1, group=grp_pivot)

grp_logic = "Red Box Rules"
maxBars   = input.int(5, title="Max Bars for Fakeout to Occur", minval=1, group=grp_logic)

grp_filters = "Institutional Filters"
useAtrFilter = input.bool(true, title="Require Minimum Breakout (ATR)", group=grp_filters)
atrLength    = input.int(14, title="ATR Length", group=grp_filters)
atrMult      = input.float(0.3, title="ATR Multiplier", step=0.1, group=grp_filters)

useVolFilter = input.bool(false, title="Require Volume Surge", group=grp_filters, tooltip="Useful for MGC if your data feed provides accurate tick volume.")
volLength    = input.int(20, title="Volume MA Length", group=grp_filters)
volMult      = input.float(1.2, title="Volume Spike Multiplier", step=0.1, group=grp_filters)

grp_box   = "Visuals"
redBoxCol = input.color(color.new(color.red, 70), title="Bearish Trap Box", group=grp_box)
grnBoxCol = input.color(color.new(color.green, 70), title="Bullish Trap Box", group=grp_box)
showLines = input.bool(true, title="Show Hunted Levels", group=grp_box)

// =========================================================================
// 2. DATA & FILTERS
// =========================================================================
atr = ta.atr(atrLength)
volMa = ta.sma(volume, volLength)

ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low, leftBars, rightBars)

volSpike = useVolFilter ? (volume > (volMa * volMult)) : true

// Output custom states to the Data Window for the Gemini MCP to scrape
plot(atr, title="ATR", display=display.data_window)

// =========================================================================
// 3. STATE MACHINE: RESISTANCE (BEARISH RED BOX)
// =========================================================================
var float resLevel = na
var int   resState = 0   
var float resExtreme = na
var int   resBreakoutIdx = na

// Only look for new retail resistance if we aren't currently tracking a trap
if not na(ph) and resState == 0
    resLevel := ph

plot(showLines and resState == 0 ? resLevel : na, title="Tracking Res", color=color.new(color.red, 50), style=plot.style_stepline)

// Logic execution
if not na(resLevel)
    validResBreak = (close > resLevel) and (useAtrFilter ? (close - resLevel) > (atr * atrMult) : true)
    
    // Trigger Breakout
    if resState == 0 and validResBreak
        resState := 1
        resExtreme := high
        resBreakoutIdx := bar_index
    
    // Manage Active Breakout
    else if resState == 1
        resExtreme := math.max(resExtreme, high) 
        
        // Timeout: Real trend, not a trap.
        if (bar_index - resBreakoutIdx) > maxBars
            resLevel := na
            resState := 0
            
        // Trap Sprung: Price closes back under resistance
        else if close < resLevel 
            if volSpike
                // DRAW VISUALS
                box.new(left=resBreakoutIdx, top=resExtreme, right=bar_index, bottom=resLevel, bgcolor=redBoxCol, border_color=color.red)
                label.new(x=bar_index, y=high, text="BEAR\nTRAP", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
                
                // FIRE AUTOMATION ALERT
                alert("Red Box Bearish Trap Triggered. Ticker: " + syminfo.ticker + " Entry: " + str.tostring(close) + " Stop: " + str.tostring(resExtreme), alert.freq_once_per_bar_close)
                
                // RESET STATE
                resLevel := na 
                resState := 0 
            else
                resLevel := na 
                resState := 0 

// =========================================================================
// 4. STATE MACHINE: SUPPORT (BULLISH RED BOX)
// =========================================================================
var float supLevel = na
var int   supState = 0   
var float supExtreme = na
var int   supBreakoutIdx = na

// Only look for new retail support if we aren't currently tracking a trap
if not na(pl) and supState == 0
    supLevel := pl

plot(showLines and supState == 0 ? supLevel : na, title="Tracking Sup", color=color.new(color.green, 50), style=plot.style_stepline)

// Logic execution
if not na(supLevel)
    validSupBreak = (close < supLevel) and (useAtrFilter ? (supLevel - close) > (atr * atrMult) : true)

    // Trigger Breakdown
    if supState == 0 and validSupBreak
        supState := 1
        supExtreme := low
        supBreakoutIdx := bar_index
    
    // Manage Active Breakdown
    else if supState == 1
        supExtreme := math.min(supExtreme, low) 
        
        // Timeout: Real trend, not a trap.
        if (bar_index - supBreakoutIdx) > maxBars
            supLevel := na
            supState := 0
            
        // Trap Sprung: Price closes back over support
        else if close > supLevel 
            if volSpike
                // DRAW VISUALS
                box.new(left=supBreakoutIdx, top=supLevel, right=bar_index, bottom=supExtreme, bgcolor=grnBoxCol, border_color=color.green)
                label.new(x=bar_index, y=low, text="BULL\nTRAP", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
                
                // FIRE AUTOMATION ALERT
                alert("Red Box Bullish Trap Triggered. Ticker: " + syminfo.ticker + " Entry: " + str.tostring(close) + " Stop: " + str.tostring(supExtreme), alert.freq_once_per_bar_close)
                
                // RESET STATE
                supLevel := na 
                supState := 0 
            else
                supLevel := na 
                supState := 0
