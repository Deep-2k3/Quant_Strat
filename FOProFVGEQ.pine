#region Using declarations
using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.ComponentModel.DataAnnotations;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Input;
using System.Windows.Media;
using System.Xml.Serialization;
using NinjaTrader.Cbi;
using NinjaTrader.Gui;
using NinjaTrader.Gui.Chart;
using NinjaTrader.Gui.Tools;
using NinjaTrader.Data;
using NinjaTrader.NinjaScript;
using NinjaTrader.NinjaScript.DrawingTools;
#endregion

// Moved outside the namespace to permanently fix the NT8 Code Generator bug
public enum OpExtensionMode
{
    UntilMitigated,
    UntilEOD,
    Unlimited
}

namespace NinjaTrader.NinjaScript.Indicators
{
    public class GapBox
    {
        public DateTime BirthTime;
        public DateTime DeathTime = DateTime.MaxValue; 
        public bool IsMitigated = false;
        public double Top;
        public double Bot;
        public double Size;
        public int SessionID;
    }

    public class KzBox
    {
        public DateTime StartTime;
        public DateTime EndTime;
        public double High = double.MinValue;
        public double Low = double.MaxValue;
        public bool IsActive = true;
        
        public bool HighActive = true;
        public DateTime HighEnd;
        
        public bool LowActive = true;
        public DateTime LowEnd;
        
        public Brush BoxColor;
        public string CodePrefix;
        public bool DrawBox;
        public int SessionID;
    }

    public class OpenLine
    {
        public DateTime StartTime;
        public DateTime EndTime = DateTime.MaxValue;
        public double Price;
        public string Label;
        public Brush LineColor;
        public int SessionID;
    }

    public class FOProFVGEQ : Indicator
    {
        // FVG Tracking
        private List<GapBox> bullBoxes = new List<GapBox>();
        private List<GapBox> bearBoxes = new List<GapBox>();
        private List<GapBox> bullIfvgBoxes = new List<GapBox>();
        private List<GapBox> bearIfvgBoxes = new List<GapBox>();

        // Killzone Tracking
        private List<KzBox> killzones = new List<KzBox>();
        private KzBox activeAsia, activeLondon, activeNyAm, activeNyLunch, activeNyPm;

        // Opening Prices Tracking
        private List<OpenLine> openLinesList = new List<OpenLine>();
        private DateTime op1LastDate, op2LastDate, op3LastDate, op4LastDate, op5LastDate, op6LastDate, op7LastDate, op8LastDate;

        // Daily EQ Tracking
        private double dayHigh = double.MinValue;
        private double dayLow = double.MaxValue;
        private DateTime dayStart = DateTime.MinValue;

        // Session ID Engine
        private int sessionCounter = 0;

        protected override void OnStateChange()
        {
            if (State == State.SetDefaults)
            {
                Description = "TFO Pro FVGs, Killzones, Opening Lines, and Daily Equilibrium";
                Name = "FOProFVGEQ";
                Calculate = Calculate.OnPriceChange;
                IsOverlay = true;
                DisplayInDataBox = false;
                PaintPriceMarkers = false;

                // 1. Master Toggles
                EnableFVGs = true;
                EnableEQ = true;
                EnableKillzones = true;

                // 2. FVG Settings
                SizeUnitIsTicks = true; 
                MinSize = 1.0;
                MaxSize = 5000.0;

                // 3. FVG Visuals & Cleanup
                FixedFvgMargin = 15;
                FixedIfvgMargin = 30;
                MaxFvgAgeHours = 24.0;
                MaxIfvgAgeHours = 24.0;
                DeleteMitigated = false; 
                ShowInversions = false;
                FilterNyOpen = true;

                BullColor = Brushes.CadetBlue; 
                BearColor = Brushes.Gray;
                BullIfvgCol = Brushes.SteelBlue;
                BearIfvgCol = Brushes.SlateGray;
                FvgOpacity = 20;

                // 4. Daily Equilibrium
                EqColor = Brushes.Orange;
                EqWidth = 2;
                EqStyle = DashStyleHelper.Dot;
                EqTextColor = Brushes.Orange;
                EqTextSize = 10;
                EqRightMargin = 15;

                // 5. Killzone Toggles
                ShowKzPivots = true;
                ShowKzLabels = true;
                
                UseAsia = true; DrawAsiaBox = true;
                UseLondon = true; DrawLondonBox = true;
                UseNyAm = true; DrawNyAmBox = false; 
                UseNyLunch = false; DrawNyLunchBox = false;
                UseNyPm = true; DrawNyPmBox = true;

                // 6. Killzone Times
                AsiaStart = DateTime.Parse("20:00:00"); AsiaEnd = DateTime.Parse("00:00:00");
                LondonStart = DateTime.Parse("02:00:00"); LondonEnd = DateTime.Parse("05:00:00");
                NyAmStart = DateTime.Parse("09:30:00"); NyAmEnd = DateTime.Parse("11:00:00");
                NyLunchStart = DateTime.Parse("12:00:00"); NyLunchEnd = DateTime.Parse("13:00:00");
                NyPmStart = DateTime.Parse("13:30:00"); NyPmEnd = DateTime.Parse("16:00:00");
                NyFilterStart = DateTime.Parse("09:30:00"); NyFilterEnd = DateTime.Parse("09:35:00");

                // 7. Killzone Visuals
                AsiaColor = Brushes.MediumTurquoise;
                LondonColor = Brushes.Plum;
                NyAmColor = Brushes.SlateBlue;
                NyLunchColor = Brushes.Yellow;
                NyPmColor = Brushes.MediumPurple;
                KzOpacity = 10;
                KzDaysToKeep = 3;
                KzTextColor = Brushes.White;
                KzTextSize = 10;
                KzRightMargin = 15;

                // 8. Opening Prices
                OpExtMode = OpExtensionMode.UntilEOD;
                OpTextAlign = TextAlignment.Right;
                OpTextSize = 10;
                OpTextColor = Brushes.White;
                OpStyle = DashStyleHelper.Dash;
                OpWidth = 1;
                OpRightMargin = 15;

                Op1Use = true; Op1Label = "True Day Open"; Op1Time = DateTime.Parse("00:00:00"); Op1Color = Brushes.MediumVioletRed;
                Op2Use = true; Op2Label = "8:30 open"; Op2Time = DateTime.Parse("08:30:00"); Op2Color = Brushes.MediumVioletRed;
                Op3Use = true; Op3Label = "10:00"; Op3Time = DateTime.Parse("10:00:00"); Op3Color = Brushes.MediumVioletRed;
                Op4Use = false; Op4Label = "14:00"; Op4Time = DateTime.Parse("14:00:00"); Op4Color = Brushes.SlateBlue;
                Op5Use = false; Op5Label = "00:00"; Op5Time = DateTime.Parse("00:00:00"); Op5Color = Brushes.SlateBlue;
                Op6Use = false; Op6Label = "00:00"; Op6Time = DateTime.Parse("00:00:00"); Op6Color = Brushes.SlateBlue;
                Op7Use = false; Op7Label = "00:00"; Op7Time = DateTime.Parse("00:00:00"); Op7Color = Brushes.SlateBlue;
                Op8Use = false; Op8Label = "00:00"; Op8Time = DateTime.Parse("00:00:00"); Op8Color = Brushes.SlateBlue;
            }
        }

        protected override void OnBarUpdate()
        {
            if (CurrentBar < 5) return; 

            if (IsFirstTickOfBar)
            {
                if (Bars.IsFirstBarOfSession)
                {
                    sessionCounter++; 
                }
            }

            TimeSpan tvTimeOfDay = Time[1].TimeOfDay; 

            // --- 1. DAILY EQUILIBRIUM ---
            if (EnableEQ)
            {
                if (Bars.IsFirstBarOfSession)
                {
                    dayHigh = High[0];
                    dayLow = Low[0];
                    dayStart = Time[0];
                }
                else
                {
                    dayHigh = Math.Max(dayHigh, High[0]);
                    dayLow = Math.Min(dayLow, Low[0]);
                }
            }

            // --- 2. KILLZONE ENGINE ---
            if (EnableKillzones)
            {
                if (UseAsia) UpdateKillzone(ref activeAsia, "AS", AsiaStart.TimeOfDay, AsiaEnd.TimeOfDay, tvTimeOfDay, AsiaColor, DrawAsiaBox);
                if (UseLondon) UpdateKillzone(ref activeLondon, "LO", LondonStart.TimeOfDay, LondonEnd.TimeOfDay, tvTimeOfDay, LondonColor, DrawLondonBox);
                if (UseNyAm) UpdateKillzone(ref activeNyAm, "NYAM", NyAmStart.TimeOfDay, NyAmEnd.TimeOfDay, tvTimeOfDay, NyAmColor, DrawNyAmBox);
                if (UseNyLunch) UpdateKillzone(ref activeNyLunch, "NYL", NyLunchStart.TimeOfDay, NyLunchEnd.TimeOfDay, tvTimeOfDay, NyLunchColor, DrawNyLunchBox);
                if (UseNyPm) UpdateKillzone(ref activeNyPm, "NYPM", NyPmStart.TimeOfDay, NyPmEnd.TimeOfDay, tvTimeOfDay, NyPmColor, DrawNyPmBox);
            }

            if (IsFirstTickOfBar)
            {
                // --- 3. OPENING PRICES EVALUATION & MITIGATION ---
                CheckOpenPrice(ref op1LastDate, Op1Use, Op1Time.TimeOfDay, Op1Label, Op1Color);
                CheckOpenPrice(ref op2LastDate, Op2Use, Op2Time.TimeOfDay, Op2Label, Op2Color);
                CheckOpenPrice(ref op3LastDate, Op3Use, Op3Time.TimeOfDay, Op3Label, Op3Color);
                CheckOpenPrice(ref op4LastDate, Op4Use, Op4Time.TimeOfDay, Op4Label, Op4Color);
                CheckOpenPrice(ref op5LastDate, Op5Use, Op5Time.TimeOfDay, Op5Label, Op5Color);
                CheckOpenPrice(ref op6LastDate, Op6Use, Op6Time.TimeOfDay, Op6Label, Op6Color);
                CheckOpenPrice(ref op7LastDate, Op7Use, Op7Time.TimeOfDay, Op7Label, Op7Color);
                CheckOpenPrice(ref op8LastDate, Op8Use, Op8Time.TimeOfDay, Op8Label, Op8Color);

                foreach (var op in openLinesList)
                {
                    if (op.EndTime != DateTime.MaxValue) continue; 

                    if (OpExtMode == OpExtensionMode.UntilMitigated)
                    {
                        if (op.StartTime != Time[1] && High[1] >= op.Price && Low[1] <= op.Price)
                        {
                            op.EndTime = Time[1];
                        }
                    }
                    else if (OpExtMode == OpExtensionMode.UntilEOD)
                    {
                        if (sessionCounter > op.SessionID)
                        {
                            op.EndTime = Time[1]; 
                        }
                    }
                }

                // --- 4. KILLZONE MITIGATIONS ---
                if (EnableKillzones && ShowKzPivots)
                {
                    foreach (var kz in killzones)
                    {
                        if (!kz.IsActive)
                        {
                            if (kz.HighActive && High[1] > kz.High) { kz.HighActive = false; kz.HighEnd = Time[1]; }
                            else if (kz.HighActive) kz.HighEnd = Time[0];

                            if (kz.LowActive && Low[1] < kz.Low) { kz.LowActive = false; kz.LowEnd = Time[1]; }
                            else if (kz.LowActive) kz.LowEnd = Time[0];
                        }
                    }
                }

                if (!EnableFVGs) return;

                TimeSpan maxFvgAge = TimeSpan.FromHours(MaxFvgAgeHours);
                TimeSpan maxIfvgAge = TimeSpan.FromHours(MaxIfvgAgeHours);

                // --- 5. FVG MITIGATIONS ---
                for (int i = bullBoxes.Count - 1; i >= 0; i--)
                {
                    var gb = bullBoxes[i];
                    if (gb.IsMitigated) continue;
                    if (Time[1] - gb.BirthTime > maxFvgAge) { bullBoxes.RemoveAt(i); continue; }

                    if (Close[1] < gb.Bot) 
                    {
                        gb.IsMitigated = true; gb.DeathTime = Time[1]; 
                        if (ShowInversions) bearIfvgBoxes.Add(new GapBox { BirthTime = gb.BirthTime, Top = gb.Top, Bot = gb.Bot, Size = gb.Size });
                        if (DeleteMitigated) bullBoxes.RemoveAt(i);
                    }
                }

                for (int i = bearBoxes.Count - 1; i >= 0; i--)
                {
                    var gb = bearBoxes[i];
                    if (gb.IsMitigated) continue;
                    if (Time[1] - gb.BirthTime > maxFvgAge) { bearBoxes.RemoveAt(i); continue; }

                    if (Close[1] > gb.Top) 
                    {
                        gb.IsMitigated = true; gb.DeathTime = Time[1];
                        if (ShowInversions) bullIfvgBoxes.Add(new GapBox { BirthTime = gb.BirthTime, Top = gb.Top, Bot = gb.Bot, Size = gb.Size });
                        if (DeleteMitigated) bearBoxes.RemoveAt(i);
                    }
                }

                for (int i = bullIfvgBoxes.Count - 1; i >= 0; i--)
                {
                    var gb = bullIfvgBoxes[i];
                    if (gb.IsMitigated) continue;
                    if (Time[1] - gb.BirthTime > maxIfvgAge) { bullIfvgBoxes.RemoveAt(i); continue; }
                    if (Close[1] < gb.Bot) { gb.IsMitigated = true; gb.DeathTime = Time[1]; if (DeleteMitigated) bullIfvgBoxes.RemoveAt(i); }
                }

                for (int i = bearIfvgBoxes.Count - 1; i >= 0; i--)
                {
                    var gb = bearIfvgBoxes[i];
                    if (gb.IsMitigated) continue;
                    if (Time[1] - gb.BirthTime > maxIfvgAge) { bearIfvgBoxes.RemoveAt(i); continue; }
                    if (Close[1] > gb.Top) { gb.IsMitigated = true; gb.DeathTime = Time[1]; if (DeleteMitigated) bearIfvgBoxes.RemoveAt(i); }
                }

                // --- 6. FVG CREATION ---
                bool isBullFvg = Low[1] > High[3];
                bool isBearFvg = High[1] < Low[3];

                if (isBullFvg && AllowFvg())
                {
                    double top = Low[1]; double bot = High[3];
                    double size = CalculateSize(top, bot);
                    if (size >= MinSize && size <= MaxSize) bullBoxes.Add(new GapBox { BirthTime = Time[3], Top = top, Bot = bot, Size = size, SessionID = sessionCounter });
                }

                if (isBearFvg && AllowFvg())
                {
                    double top = Low[3]; double bot = High[1];
                    double size = CalculateSize(top, bot);
                    if (size >= MinSize && size <= MaxSize) bearBoxes.Add(new GapBox { BirthTime = Time[3], Top = top, Bot = bot, Size = size, SessionID = sessionCounter });
                }

                if (bullBoxes.Count > 200) bullBoxes.RemoveAt(0);
                if (bearBoxes.Count > 200) bearBoxes.RemoveAt(0);
                if (bullIfvgBoxes.Count > 200) bullIfvgBoxes.RemoveAt(0);
                if (bearIfvgBoxes.Count > 200) bearIfvgBoxes.RemoveAt(0);
            }
        }

        private void CheckOpenPrice(ref DateTime lastDate, bool use, TimeSpan target, string label, Brush color)
        {
            if (!use) return;

            DateTime todayDate = Time[1].Date;
            if (lastDate == todayDate) return;

            TimeSpan t1 = Time[1].TimeOfDay;
            TimeSpan t0 = Time[0].TimeOfDay;

            bool triggered = false;
            if (t1 <= target && t0 > target) triggered = true;
            else if (t1 > t0) 
            {
                if (target >= t1 || target < t0) triggered = true;
            }

            if (triggered)
            {
                lastDate = todayDate;
                openLinesList.Add(new OpenLine { StartTime = Time[1], Price = Open[0], Label = label, LineColor = color, SessionID = sessionCounter });
                
                // --- STRICT INSERTION TRIMMER FOR OPENING PRICES ---
                var specificLines = openLinesList.Where(x => x.Label == label).ToList();
                while (specificLines.Count > KzDaysToKeep)
                {
                    openLinesList.Remove(specificLines[0]);
                    specificLines.RemoveAt(0);
                }
            }
        }

        private void UpdateKillzone(ref KzBox kz, string prefix, TimeSpan start, TimeSpan end, TimeSpan currentTod, Brush color, bool drawBox)
        {
            bool inSession = false;
            if (start <= end) inSession = currentTod >= start && currentTod < end;
            else inSession = currentTod >= start || currentTod < end; 

            if (inSession)
            {
                if (kz == null)
                {
                    kz = new KzBox { 
                        StartTime = Time[1], EndTime = Time[0], High = High[0], Low = Low[0], 
                        BoxColor = color, CodePrefix = prefix, DrawBox = drawBox, SessionID = sessionCounter
                    };
                    killzones.Add(kz);

                    // --- STRICT INSERTION TRIMMER FOR KILLZONES ---
                    var specificZones = killzones.Where(x => x.CodePrefix == prefix).ToList();
                    while (specificZones.Count > KzDaysToKeep)
                    {
                        killzones.Remove(specificZones[0]);
                        specificZones.RemoveAt(0);
                    }
                }
                else
                {
                    kz.EndTime = Time[0];
                    kz.High = Math.Max(kz.High, High[0]);
                    kz.Low = Math.Min(kz.Low, Low[0]);
                    kz.HighEnd = Time[0];
                    kz.LowEnd = Time[0];
                    kz.DrawBox = drawBox;
                }
            }
            else if (kz != null)
            {
                kz.IsActive = false;
                kz = null;
            }
        }

        private double CalculateSize(double top, double bot)
        {
            double diff = Math.Abs(top - bot);
            return SizeUnitIsTicks ? (diff / TickSize) : diff;
        }

        private bool AllowFvg()
        {
            if (!FilterNyOpen) return true;
            bool IsNyFakeout(int n)
            {
                TimeSpan openTod = Time[n + 1].TimeOfDay;
                return openTod >= NyFilterStart.TimeOfDay && openTod < NyFilterEnd.TimeOfDay;
            }
            return !(IsNyFakeout(1) || IsNyFakeout(2) || IsNyFakeout(3));
        }

        protected override void OnRender(ChartControl chartControl, ChartScale chartScale)
        {
            base.OnRender(chartControl, chartScale);

            if (Bars == null || ChartPanel == null) return;
            DateTime lastTime = Bars.GetTime(Bars.Count - 1);

            // --- RENDER OPENING PRICES ---
            var scbOpTxt = OpTextColor as SolidColorBrush;
            if (scbOpTxt != null)
            {
                using (var lblFormat = new SharpDX.DirectWrite.TextFormat(NinjaTrader.Core.Globals.DirectWriteFactory, "Arial", SharpDX.DirectWrite.FontWeight.Bold, SharpDX.DirectWrite.FontStyle.Normal, OpTextSize))
                using (var strokeStyleOp = new SharpDX.Direct2D1.StrokeStyle(RenderTarget.Factory, new SharpDX.Direct2D1.StrokeStyleProperties { DashStyle = GetDXDash(OpStyle) }))
                using (var dxOpTxt = new SharpDX.Direct2D1.SolidColorBrush(RenderTarget, new SharpDX.Color((int)scbOpTxt.Color.R, (int)scbOpTxt.Color.G, (int)scbOpTxt.Color.B, 255)))
                {
                    foreach (var op in openLinesList)
                    {
                        var scbOp = op.LineColor as SolidColorBrush;
                        if (scbOp == null) continue;

                        using (var dxOp = new SharpDX.Direct2D1.SolidColorBrush(RenderTarget, new SharpDX.Color((int)scbOp.Color.R, (int)scbOp.Color.G, (int)scbOp.Color.B, 255)))
                        {
                            float startX = chartControl.GetXByTime(op.StartTime);
                            float endX = op.EndTime != DateTime.MaxValue 
                                ? chartControl.GetXByTime(op.EndTime) 
                                : chartControl.GetXByTime(lastTime) + (OpRightMargin * chartControl.Properties.BarDistance);
                                
                            float y = chartScale.GetYByValue(op.Price);

                            RenderTarget.DrawLine(new SharpDX.Vector2(startX, y), new SharpDX.Vector2(endX, y), dxOp, OpWidth, strokeStyleOp);

                            float rectWidth = 400;
                            float rectX = startX + 5;

                            if (OpTextAlign == TextAlignment.Right) {
                                rectX = endX - rectWidth;
                                lblFormat.TextAlignment = SharpDX.DirectWrite.TextAlignment.Trailing;
                            } else if (OpTextAlign == TextAlignment.Center) {
                                rectX = startX;
                                rectWidth = endX - startX;
                                lblFormat.TextAlignment = SharpDX.DirectWrite.TextAlignment.Center;
                            } else {
                                lblFormat.TextAlignment = SharpDX.DirectWrite.TextAlignment.Leading;
                            }

                            var textRect = new SharpDX.RectangleF(rectX, y - OpTextSize - 4, rectWidth, OpTextSize + 5);
                            RenderTarget.DrawText(op.Label, lblFormat, textRect, dxOpTxt);
                        }
                    }
                }
            }

            // --- RENDER KILLZONES ---
            if (EnableKillzones)
            {
                var scbKzTxt = KzTextColor as SolidColorBrush;
                if (scbKzTxt != null)
                {
                    using (var strokeStyleSolid = new SharpDX.Direct2D1.StrokeStyle(RenderTarget.Factory, new SharpDX.Direct2D1.StrokeStyleProperties { DashStyle = SharpDX.Direct2D1.DashStyle.Solid }))
                    using (var lblFormat = new SharpDX.DirectWrite.TextFormat(NinjaTrader.Core.Globals.DirectWriteFactory, "Arial", SharpDX.DirectWrite.FontWeight.Bold, SharpDX.DirectWrite.FontStyle.Normal, KzTextSize))
                    using (var dxKzTxt = new SharpDX.Direct2D1.SolidColorBrush(RenderTarget, new SharpDX.Color((int)scbKzTxt.Color.R, (int)scbKzTxt.Color.G, (int)scbKzTxt.Color.B, 255)))
                    {
                        lblFormat.TextAlignment = SharpDX.DirectWrite.TextAlignment.Trailing; 

                        foreach (var kz in killzones)
                        {
                            var scbKz = kz.BoxColor as SolidColorBrush;
                            if (scbKz == null) continue;

                            using (var dxKzBox = new SharpDX.Direct2D1.SolidColorBrush(RenderTarget, new SharpDX.Color((int)scbKz.Color.R, (int)scbKz.Color.G, (int)scbKz.Color.B, (int)(KzOpacity * 2.55f))))
                            using (var dxKzPivot = new SharpDX.Direct2D1.SolidColorBrush(RenderTarget, new SharpDX.Color((int)scbKz.Color.R, (int)scbKz.Color.G, (int)scbKz.Color.B, 255)))
                            {
                                float startX = chartControl.GetXByTime(kz.StartTime);
                                float boxEndX = chartControl.GetXByTime(kz.IsActive ? lastTime : kz.EndTime);
                                float topY = chartScale.GetYByValue(kz.High);
                                float botY = chartScale.GetYByValue(kz.Low);

                                if (kz.DrawBox)
                                {
                                    var rect = new SharpDX.RectangleF(startX, Math.Min(topY, botY), Math.Max(1, boxEndX - startX), Math.Abs(topY - botY));
                                    RenderTarget.FillRectangle(rect, dxKzBox);
                                }

                                if (ShowKzPivots && !kz.IsActive)
                                {
                                    float pivotStartX = boxEndX; 
                                    
                                    float pHighEndX = kz.HighActive 
                                        ? chartControl.GetXByTime(lastTime) + (KzRightMargin * chartControl.Properties.BarDistance)
                                        : chartControl.GetXByTime(kz.HighEnd);
                                        
                                    RenderTarget.DrawLine(new SharpDX.Vector2(pivotStartX, topY), new SharpDX.Vector2(pHighEndX, topY), dxKzPivot, 1, strokeStyleSolid);

                                    if (ShowKzLabels)
                                    {
                                        var hiRect = new SharpDX.RectangleF(pHighEndX - 80, topY - KzTextSize - 3, 80, KzTextSize + 2);
                                        RenderTarget.DrawText($"{kz.CodePrefix}.H", lblFormat, hiRect, dxKzTxt);
                                    }

                                    float pLowEndX = kz.LowActive 
                                        ? chartControl.GetXByTime(lastTime) + (KzRightMargin * chartControl.Properties.BarDistance)
                                        : chartControl.GetXByTime(kz.LowEnd);
                                        
                                    RenderTarget.DrawLine(new SharpDX.Vector2(pivotStartX, botY), new SharpDX.Vector2(pLowEndX, botY), dxKzPivot, 1, strokeStyleSolid);

                                    if (ShowKzLabels)
                                    {
                                        var loRect = new SharpDX.RectangleF(pLowEndX - 80, botY + 2, 80, KzTextSize + 2);
                                        RenderTarget.DrawText($"{kz.CodePrefix}.L", lblFormat, loRect, dxKzTxt);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // --- RENDER FVGs & DAILY EQ ---
            var scbBull = BullColor as SolidColorBrush;
            var scbBear = BearColor as SolidColorBrush;
            var scbBullIfvg = BullIfvgCol as SolidColorBrush;
            var scbBearIfvg = BearIfvgCol as SolidColorBrush;
            var scbEq = EqColor as SolidColorBrush;
            var scbEqTxt = EqTextColor as SolidColorBrush;

            if (scbBull == null || scbBear == null || scbEq == null || scbEqTxt == null) return;

            using (var dxBull = new SharpDX.Direct2D1.SolidColorBrush(RenderTarget, new SharpDX.Color((int)scbBull.Color.R, (int)scbBull.Color.G, (int)scbBull.Color.B, (int)(FvgOpacity * 2.55f))))
            using (var dxBear = new SharpDX.Direct2D1.SolidColorBrush(RenderTarget, new SharpDX.Color((int)scbBear.Color.R, (int)scbBear.Color.G, (int)scbBear.Color.B, (int)(FvgOpacity * 2.55f))))
            using (var dxBullIfvg = new SharpDX.Direct2D1.SolidColorBrush(RenderTarget, new SharpDX.Color((int)scbBullIfvg.Color.R, (int)scbBullIfvg.Color.G, (int)scbBullIfvg.Color.B, (int)(FvgOpacity * 2.55f))))
            using (var dxBearIfvg = new SharpDX.Direct2D1.SolidColorBrush(RenderTarget, new SharpDX.Color((int)scbBearIfvg.Color.R, (int)scbBearIfvg.Color.G, (int)scbBearIfvg.Color.B, (int)(FvgOpacity * 2.55f))))
            using (var dxEq = new SharpDX.Direct2D1.SolidColorBrush(RenderTarget, new SharpDX.Color((int)scbEq.Color.R, (int)scbEq.Color.G, (int)scbEq.Color.B, 255)))
            using (var dxEqTxt = new SharpDX.Direct2D1.SolidColorBrush(RenderTarget, new SharpDX.Color((int)scbEqTxt.Color.R, (int)scbEqTxt.Color.G, (int)scbEqTxt.Color.B, 255)))
            using (var eqLblFormat = new SharpDX.DirectWrite.TextFormat(NinjaTrader.Core.Globals.DirectWriteFactory, "Arial", SharpDX.DirectWrite.FontWeight.Normal, SharpDX.DirectWrite.FontStyle.Normal, EqTextSize))
            {
                void DrawZoneBoxes(List<GapBox> list, SharpDX.Direct2D1.SolidColorBrush brush, int margin)
                {
                    foreach (var gb in list)
                    {
                        float startX = chartControl.GetXByTime(gb.BirthTime);
                        float endX = gb.IsMitigated ? chartControl.GetXByTime(gb.DeathTime) : chartControl.GetXByTime(lastTime) + (margin * chartControl.Properties.BarDistance);
                        float topY = chartScale.GetYByValue(gb.Top);
                        float botY = chartScale.GetYByValue(gb.Bot);
                        var rect = new SharpDX.RectangleF(startX, Math.Min(topY, botY), Math.Max(1, endX - startX), Math.Abs(topY - botY));
                        RenderTarget.FillRectangle(rect, brush);
                    }
                }

                if (EnableFVGs)
                {
                    DrawZoneBoxes(bullBoxes, dxBull, FixedFvgMargin);
                    DrawZoneBoxes(bearBoxes, dxBear, FixedFvgMargin);
                    DrawZoneBoxes(bullIfvgBoxes, dxBullIfvg, FixedIfvgMargin);
                    DrawZoneBoxes(bearIfvgBoxes, dxBearIfvg, FixedIfvgMargin);
                }

                if (EnableEQ && dayStart != DateTime.MinValue)
                {
                    double equilibrium = (dayHigh + dayLow) / 2.0;
                    float eqY = chartScale.GetYByValue(equilibrium);
                    float startX = chartControl.GetXByTime(dayStart);
                    float endX = chartControl.GetXByTime(lastTime) + (EqRightMargin * chartControl.Properties.BarDistance); 

                    using (var strokeStyle = new SharpDX.Direct2D1.StrokeStyle(RenderTarget.Factory, new SharpDX.Direct2D1.StrokeStyleProperties { DashStyle = GetDXDash(EqStyle) }))
                    {
                        RenderTarget.DrawLine(new SharpDX.Vector2(startX, eqY), new SharpDX.Vector2(endX, eqY), dxEq, EqWidth, strokeStyle);
                        eqLblFormat.TextAlignment = SharpDX.DirectWrite.TextAlignment.Leading; 
                        RenderTarget.DrawText($"EQ: {equilibrium}", eqLblFormat, new SharpDX.RectangleF(endX + 5, eqY - EqTextSize, 100, 20), dxEqTxt);
                    }
                }
            }
        }

        private SharpDX.Direct2D1.DashStyle GetDXDash(DashStyleHelper style)
        {
            switch (style)
            {
                case DashStyleHelper.Dash: return SharpDX.Direct2D1.DashStyle.Dash;
                case DashStyleHelper.Dot: return SharpDX.Direct2D1.DashStyle.Dot;
                default: return SharpDX.Direct2D1.DashStyle.Solid;
            }
        }

